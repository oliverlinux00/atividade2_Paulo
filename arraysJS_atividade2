// 16. A partir de um array contendo os números 12, 7, 5, 20, 33, 8, 11 e 4, você precisa gerar um resumo numérico para o
// relatório. Percorra o array, conte quantos números são pares e quantos são ímpares e exiba ambas as quantidades
// no terminal.

const numeros = [12, 7, 5, 20, 33, 8, 11, 4, 8]

let pares = 0
let impares = 0

numeros.forEach ((num) => {
    
    if (num % 2 == 0) {
        pares = pares + 1
    } else {
        impares = impares + 1
    }

} )

console.log(numeros)
console.log("Quantidade de Pares: " + pares)
console.log("Quantidade de Ímpares: " + impares)


// 17. Durante o monitoramento de um dia, foram registradas as temperaturas 22, 29, 18, 31, 24 e 19 em um array.
// Percorra os elementos com estrutura condicional para descobrir qual foi a maior e qual foi a menor temperatura
// registrada e exiba no terminal.


const temperatura = [22, 29, 18, 31, 24, 19];

let maior = temperatura[0];
let menor = temperatura[0];

temperatura.forEach((temp) => {

    if (temp > maior) {
        maior = temp;
    }

    if (temp < menor) {
        menor = temp;
    }

});

console.log("Maior temperatura:", maior);
console.log("Menor temperatura:", menor);



// 18. Um cliente pediu para cancelar "Batata Frita" de um pedido que já tinha "Hambúrguer", "Batata Frita", "Refrigerante"
// e "Sobremesa" em um array. Localize a posição desse item no array, remova-o da lista e exiba o pedido atualizado
